{
  "name": "mecha-overdrive-circuit-zero",
  "version": "2.3.0",
  "private": true,
  "description": "MECHA OVERDRIVE 2.3.0 : jeu de course-combat de méchas 3D sous Godot, avec compagnon web autonome.",
  "type": "module",
  "scripts": {
    "start": "node tools/server.mjs",
    "serve": "node tools/server.mjs",
    "serve:python": "python3 tools/serve.py",
    "check": "node tools/check.mjs",
    "validate": "node tools/validate.mjs",
    "test:engine": "node tests/run-tests.mjs",
    "test:integration": "node tests/smoke.mjs",
    "test:browser": "python3 tests/browser_smoke.py",
    "test:flow": "python3 tests/full_flow_qa.py",
    "test:godot-structure": "node tools/validate-godot.mjs",
    "stamp:godot-web": "node tools/stamp-godot-web.mjs",
    "test": "npm run check && npm run validate && npm run test:engine && npm run test:integration",
    "qa": "npm test && npm run test:godot-structure"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
